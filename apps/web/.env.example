# Web app env vars. Copy to .env.local to override defaults locally.
#
# Next.js automatically loads .env files in this directory. Variables prefixed
# with NEXT_PUBLIC_ are inlined into the browser bundle at build time, so
# changing the value requires a rebuild (or redeploy on Vercel).

# Base URL of the Express API.
# Defaults to http://localhost:4000 when unset, which is what local dev uses,
# so most developers won't need a .env.local file at all.
# In production this is set in the Vercel dashboard (Settings -> Environment
# Variables), not in this file.
NEXT_PUBLIC_API_URL=http://localhost:4000
