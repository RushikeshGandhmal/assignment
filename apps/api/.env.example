# Express server port
PORT=4000

# SQLite database file path (relative to apps/api). Use ":memory:" for ephemeral DBs.
DATABASE_FILE=./data/salary-management.db

# Secret used to sign auth JWTs. Must be at least 16 characters in production.
JWT_SECRET=dev-only-secret-change-me-please

# Allowed origins for CORS, comma-separated. The UI runs on a different port
# in dev so the browser treats every call as cross-origin.
CORS_ORIGIN=http://localhost:3000
